# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Verified sender in Resend (use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=Pi Tech Contact <contact@pitech.rw>

# Inbox that receives contact form + booking notifications
CONTACT_NOTIFY_EMAIL=info@pitech.rw

# Google Calendar OAuth (for /book + Google Meet)
# 1. Create OAuth client (Web) in Google Cloud Console
# 2. Enable Google Calendar API
# 3. Add authorized redirect URI: http://127.0.0.1:53682/oauth2callback
# 4. Run: npx tsx scripts/google-calendar-auth.ts
# 5. Use a Google account that can create Meet links (Workspace recommended)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
